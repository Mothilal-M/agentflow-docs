---
import SearchDialog from './SearchDialog.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '../lib/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => href.startsWith('/') && (path === href || path.startsWith(`${href}/`));
---
<header class="site-header">
  <div class="wrap header-row">
    <a class="wordmark brand-link" href="/" aria-label="10xGraph Documentation Home">
      <img
        src="/logo/10xgraph-logo-3d.png"
        alt="10xGraph Logo"
        class="brand-header-logo"
      />
      <span class="brand-badge">DOCS</span>
    </a>
    
    <a class="version-pill" href="/changelog" title={`Current release: v${SITE.version}. Read the changelog`}>
      v{SITE.version}
    </a>

    <nav aria-label="Primary">
      <ul>
        <li>
          <a href="https://10xgraph.com" target="_blank" rel="noopener noreferrer" class="ext-link">
            Landing ↗
          </a>
        </li>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li>
          <a href="https://github.com/10xGraph" target="_blank" rel="noopener noreferrer" class="ext-link">
            GitHub ↗
          </a>
        </li>
      </ul>
    </nav>

    <SearchDialog />
    <ThemeToggle />
  </div>
</header>

<style>
  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 800;
  }
  .brand-header-logo {
    height: 26px;
    width: auto;
    object-fit: contain;
    display: inline-block;
    flex-shrink: 0;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .brand-link:hover .brand-header-logo {
    transform: scale(1.05);
  }
  .brand-badge {
    font-family: var(--f-mono);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: var(--accent-wash);
    color: var(--accent);
    border: 1px solid var(--accent-line);
    letter-spacing: 0.05em;
  }
  .ext-link {
    opacity: 0.75;
  }
  .ext-link:hover {
    opacity: 1;
    color: var(--accent) !important;
  }
</style>
