---
// apps/landing/src/pages/index.astro
import { CommandPalette, InstallPill } from '@10xgraph/ui';
import { HeroProductStudio } from '../components/HeroProductStudio';
import EcosystemStrip from '../components/EcosystemStrip.astro';
import CodeToProduction from '../components/CodeToProduction.astro';
import FeatureBento from '../components/FeatureBento.astro';
import CompareMatrix from '../components/CompareMatrix.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>10xGraph - State-Graph Engine for Autonomous AI Agents</title>
  <meta name="description" content="Build deterministic AI agent graphs in Python. 10xGraph automatically generates production FastAPI servers with durable Redis checkpoints, JWT auth, and replay-safe tool ledgers." />
  <link rel="icon" type="image/jpeg" href="/logo/10xgraph-icon-badge.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --primary: #005be6;
      --primary-hover: #1e40af;
      --primary-wash: #dfecff;
      --bg: #ffffff;
      --surface-soft: #f8fafc;
      --border: #e2e8f0;
      --text: #0d0d0d;
      --text-muted: #64748b;
      --font-display: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-display);
      overflow-x: hidden;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      position: relative;
    }

    /* Ambient Hero Glow & Dribbble Atmospheric Lighting */
    .ambient-glow-layer {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 700px;
      pointer-events: none;
      z-index: 0;
      background: radial-gradient(1100px 550px at 50% -80px, rgba(0, 91, 230, 0.12), rgba(223, 236, 255, 0.45) 40%, transparent 80%);
      opacity: 0.9;
    }

    .tech-grid-pattern {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 800px;
      pointer-events: none;
      z-index: 0;
      background-image: linear-gradient(to right, rgba(0, 91, 230, 0.035) 1px, transparent 1px),
                        linear-gradient(to bottom, rgba(0, 91, 230, 0.035) 1px, transparent 1px);
      background-size: 32px 32px;
      mask-image: radial-gradient(ellipse 90% 70% at 50% 20%, black 20%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 20%, black 20%, transparent 80%);
    }

    /* Header Nav */
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      transition: all 0.2s ease;
    }
    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
      height: 4.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
    }
    .brand-logo-img {
      height: 32px;
      width: auto;
      object-fit: contain;
      transition: transform 0.2s ease;
    }
    .brand-logo-img:hover {
      transform: scale(1.04);
    }
    .nav-links {
      display: none;
      align-items: center;
      gap: 2.25rem;
      list-style: none;
    }
    @media (min-width: 768px) {
      .nav-links {
        display: flex;
      }
    }
    .nav-link {
      color: var(--text-muted);
      font-size: 0.9rem;
      font-weight: 500;
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .nav-link:hover {
      color: var(--primary);
    }
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .btn-github {
      display: none;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 1rem;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: #ffffff;
      color: #374151;
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.15s ease;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }
    @media (min-width: 640px) {
      .btn-github {
        display: inline-flex;
      }
    }
    .btn-github:hover {
      background: var(--surface-soft);
      border-color: #cbd5e1;
      transform: translateY(-1px);
    }
    .github-star-pill {
      padding: 0.1rem 0.45rem;
      background: #f1f5f9;
      border-radius: 6px;
      font-size: 0.75rem;
      color: #64748b;
      font-family: var(--font-mono);
      font-weight: 700;
    }
    .btn-cta-nav {
      display: inline-flex;
      align-items: center;
      padding: 0.55rem 1.25rem;
      border-radius: 12px;
      background: var(--primary);
      color: #ffffff;
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      box-shadow: 0 2px 8px rgba(0, 91, 230, 0.25);
      transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .btn-cta-nav:hover {
      background: var(--primary-hover);
      box-shadow: 0 4px 14px rgba(0, 91, 230, 0.35);
      transform: translateY(-1px);
    }

    /* Hero Section */
    .hero-section {
      position: relative;
      z-index: 10;
      padding: 5rem 0 6rem;
      overflow: hidden;
    }
    .hero-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 3.5rem;
      align-items: center;
    }
    @media (min-width: 1024px) {
      .hero-grid {
        grid-template-columns: 5fr 7fr;
        gap: 3.5rem;
      }
    }

    /* Hero Left Copy */
    .hero-copy {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    /* Shimmering Eyebrow Pill */
    .eyebrow-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.4rem 1rem;
      border-radius: 9999px;
      background: #ffffff;
      border: 1px solid rgba(0, 91, 230, 0.2);
      color: var(--primary);
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      width: fit-content;
      box-shadow: 0 2px 10px rgba(0, 91, 230, 0.08);
      position: relative;
      overflow: hidden;
    }
    .eyebrow-sparkle {
      color: var(--primary);
      font-size: 0.85rem;
    }
    .eyebrow-text {
      font-family: var(--font-mono);
      font-weight: 700;
      text-transform: uppercase;
    }

    .hero-headline {
      font-size: clamp(2.6rem, 5.2vw, 3.75rem);
      font-weight: 900;
      letter-spacing: -0.035em;
      line-height: 1.1;
      color: #0d0d0d;
    }
    .gradient-text {
      background: linear-gradient(135deg, #005be6 0%, #1e40af 60%, #0284c7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }

    .hero-lead {
      font-size: 1.12rem;
      line-height: 1.65;
      color: var(--text-muted);
      max-width: 530px;
    }

    /* Micro Metrics Row */
    .hero-metrics-strip {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.25rem;
      padding: 0.75rem 0;
      border-top: 1px solid #f1f5f9;
      border-bottom: 1px solid #f1f5f9;
      font-size: 0.75rem;
      font-family: var(--font-mono);
      color: #475569;
    }
    .metric-bullet {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .metric-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #10b981;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
      padding-top: 0.25rem;
    }
    .btn-hero-primary {
      padding: 0.85rem 1.85rem;
      border-radius: 12px;
      background: var(--primary);
      color: #ffffff;
      font-size: 0.95rem;
      font-weight: 600;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(0, 91, 230, 0.28);
      transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-hero-primary:hover {
      background: var(--primary-hover);
      box-shadow: 0 8px 25px rgba(0, 91, 230, 0.4);
      transform: translateY(-2px);
    }
    .btn-hero-outline {
      padding: 0.85rem 1.65rem;
      border-radius: 12px;
      background: #ffffff;
      border: 1px solid var(--border);
      color: #334155;
      font-size: 0.95rem;
      font-weight: 600;
      text-decoration: none;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .btn-hero-outline:hover {
      background: var(--surface-soft);
      border-color: #cbd5e1;
      transform: translateY(-1px);
    }

    .hero-install-row {
      padding-top: 0.25rem;
    }

    /* Keyframes */
    @keyframes packetFlow {
      0% { top: 0; opacity: 0; }
      30% { opacity: 1; }
      70% { opacity: 1; }
      100% { top: 18px; opacity: 0; }
    }
  </style>
</head>
<body>

  <!-- AMBIENT BACKGROUND LIGHTING -->
  <div class="ambient-glow-layer"></div>
  <div class="tech-grid-pattern"></div>

  <!-- STICKY NAVBAR -->
  <header class="site-nav">
    <div class="nav-container">
      <a href="/" class="brand-link" aria-label="10xGraph Home">
        <img
          src="/logo/10xgraph-logo-3d.png"
          alt="10xGraph Logo"
          class="brand-logo-img"
        />
      </a>

      <nav aria-label="Main Navigation">
        <ul class="nav-links">
          <li><a href="#how-it-works" class="nav-link">How it works</a></li>
          <li><a href="#features" class="nav-link">Features</a></li>
          <li><a href="#compare" class="nav-link">Benchmarks</a></li>
          <li><a href="https://docs.10xgraph.com" class="nav-link">Documentation</a></li>
        </ul>
      </nav>

      <div class="nav-actions">
        <a href="https://github.com/10xGraph" target="_blank" rel="noopener noreferrer" class="btn-github">
          <span>GitHub</span>
          <span class="github-star-pill">★</span>
        </a>
        <a href="https://docs.10xgraph.com/get-started/first-agent" class="btn-cta-nav">
          Get Started Free
        </a>
      </div>
    </div>
  </header>

  <!-- HERO SECTION -->
  <section class="hero-section" id="hero">
    <div class="hero-container">
      <div class="hero-grid">
        
        <!-- Left Column: Copy & Actions -->
        <div class="hero-copy">
          
          <div class="eyebrow-pill">
            <span class="eyebrow-sparkle">✦</span>
            <span class="eyebrow-text">v0.9.2 • PRODUCTION MULTI-AGENT STATE GRAPH ENGINE</span>
          </div>

          <h1 class="hero-headline">
            Build deterministic agent graphs. <span class="gradient-text">Run them in production.</span>
          </h1>

          <p class="hero-lead">
            10xGraph compiles your typed Python state graphs into self-hosted FastAPI servers with durable Redis checkpoints, JWT auth, and replay-safe tool ledgers.
          </p>

          <!-- Micro Metrics -->
          <div class="hero-metrics-strip">
            <span class="metric-bullet">
              <span class="metric-dot"></span>
              <span>&lt;0.8ms Checkpoints</span>
            </span>
            <span class="metric-bullet">
              <span class="metric-dot"></span>
              <span>Zero Double Execution</span>
            </span>
            <span class="metric-bullet">
              <span class="metric-dot"></span>
              <span>FastAPI &amp; JWT Included</span>
            </span>
          </div>

          <!-- CTAs -->
          <div class="hero-buttons">
            <a href="https://docs.10xgraph.com/get-started/first-agent" class="btn-hero-primary">
              <span>Start Building Free</span>
              <span>→</span>
            </a>
            <a href="https://docs.10xgraph.com" class="btn-hero-outline">
              View Documentation
            </a>
          </div>

          <!-- Install Pill -->
          <div class="hero-install-row">
            <InstallPill command="pip install 10xgraph 10xgraph-api" prefix="$" client:load />
          </div>

        </div>

        <!-- Right Column: Interactive 3D Hero Product Studio -->
        <div class="hero-mockup-wrapper">
          <HeroProductStudio client:load />
        </div>

      </div>
    </div>
  </section>

  <!-- ECOSYSTEM STRIP -->
  <EcosystemStrip />

  <!-- ARCHITECTURE & PIPELINE STEPPER -->
  <CodeToProduction />

  <!-- FEATURE BENTO (6 TILES WITH MOUSE SPOTLIGHT) -->
  <FeatureBento />

  <!-- BENCHMARK / COMPARISON MATRIX -->
  <CompareMatrix />

  <!-- FINAL CTA -->
  <FinalCta />

  <!-- FOOTER -->
  <Footer />

  <!-- COMMAND PALETTE MODAL -->
  <CommandPalette client:idle />

  <!-- GSAP ENTRANCE ANIMATIONS SCRIPT -->
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    window.addEventListener('DOMContentLoaded', () => {
      // Header entrance
      gsap.from('.site-nav', {
        y: -20,
        opacity: 0,
        duration: 0.6,
        ease: 'power2.out',
      });

      // Hero Elements Staggered Cascade
      const heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      heroTl
        .from('.eyebrow-pill', {
          scale: 0.9,
          opacity: 0,
          duration: 0.5,
          delay: 0.1,
        })
        .from(
          '.hero-headline',
          {
            y: 30,
            opacity: 0,
            duration: 0.7,
          },
          '-=0.3'
        )
        .from(
          '.hero-lead',
          {
            y: 20,
            opacity: 0,
            duration: 0.6,
          },
          '-=0.4'
        )
        .from(
          '.hero-metrics-strip',
          {
            y: 15,
            opacity: 0,
            duration: 0.5,
          },
          '-=0.4'
        )
        .from(
          '.hero-buttons',
          {
            y: 15,
            opacity: 0,
            duration: 0.5,
          },
          '-=0.4'
        )
        .from(
          '.hero-install-row',
          {
            y: 15,
            opacity: 0,
            duration: 0.5,
          },
          '-=0.3'
        )
        .from(
          '.hero-mockup-wrapper',
          {
            y: 40,
            opacity: 0,
            duration: 0.9,
            ease: 'power2.out',
          },
          '-=0.6'
        );

      // Scroll-triggered reveals on Bento Cards
      gsap.from('.bento-card', {
        scrollTrigger: {
          trigger: '.bento-grid',
          start: 'top 85%',
        },
        y: 40,
        opacity: 0,
        stagger: 0.1,
        duration: 0.7,
        ease: 'power2.out',
      });

      // Scroll-triggered reveals on Comparison Matrix
      gsap.from('.compare-table-wrapper', {
        scrollTrigger: {
          trigger: '.compare-table-wrapper',
          start: 'top 85%',
        },
        y: 35,
        opacity: 0,
        duration: 0.7,
        ease: 'power2.out',
      });
    });
  </script>

</body>
</html>
