---
// apps/landing/src/pages/index.astro
import { Logo, Button, InstallPill, GraphCanvas, CommandPalette } from '@10xgraph/ui';
import EcosystemStrip from '../components/EcosystemStrip.astro';
import CodeToProduction from '../components/CodeToProduction.astro';
import FeatureBento from '../components/FeatureBento.astro';
import CompareMatrix from '../components/CompareMatrix.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>10xGraph - State-Graph Engine for Autonomous AI</title>
  <meta name="description" content="Orchestrate multi-agent clusters across directed state graphs. Built for deterministic replay, time-travel checkpoints, and sub-millisecond execution telemetry." />
  <link rel="stylesheet" href="/node_modules/@10xgraph/ui/src/tokens.css" />
  <link rel="stylesheet" href="/node_modules/@10xgraph/ui/src/fonts.css" />
  <style>
    @import "@10xgraph/ui/tokens.css";
    @import "@10xgraph/ui/fonts.css";

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      overflow-x: hidden;
      min-height: 100vh;
    }

    /* Floating Navbar */
    .nav-bar {
      position: fixed;
      top: 1.25rem;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 2.5rem);
      max-width: 1120px;
      height: 3.75rem;
      border-radius: 9999px;
      background: rgba(14, 16, 20, 0.75);
      border: 1px solid var(--border);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.5rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    .nav-links {
      display: none;
      align-items: center;
      gap: 1.75rem;
      list-style: none;
    }
    @media (min-width: 768px) {
      .nav-links {
        display: flex;
      }
    }

    .nav-link {
      color: var(--text-muted);
      font-size: 0.875rem;
      font-weight: 500;
      text-decoration: none;
      transition: var(--transition-fast);
    }

    .nav-link:hover {
      color: var(--text);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .cmd-k-trigger {
      display: none;
      align-items: center;
      gap: 0.4rem;
      padding: 0.35rem 0.65rem;
      border-radius: 6px;
      background: var(--surface-2);
      border: 1px solid var(--border);
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      cursor: pointer;
    }
    @media (min-width: 860px) {
      .cmd-k-trigger {
        display: inline-flex;
      }
    }

    /* Hero Section */
    .hero-container {
      position: relative;
      width: 100%;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 8rem 1.5rem 5rem;
      overflow: hidden;
    }

    .hero-canvas-wrap {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .hero-content {
      position: relative;
      z-index: 2;
      max-width: 920px;
      pointer-events: none;
    }

    .hero-content * {
      pointer-events: auto;
    }

    .badge-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 0.95rem;
      border-radius: 9999px;
      background: rgba(200, 255, 61, 0.1);
      border: 1px solid rgba(200, 255, 61, 0.25);
      color: var(--signal);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 2rem;
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(2.75rem, 6.5vw, 5.25rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.05;
      margin-bottom: 1.5rem;
    }

    .hero-title span.accent {
      color: var(--signal);
      text-shadow: 0 0 35px rgba(200, 255, 61, 0.3);
    }

    .hero-desc {
      font-size: 1.18rem;
      line-height: 1.6;
      color: var(--text-muted);
      max-width: 700px;
      margin: 0 auto 2.5rem;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }

    .hero-install-wrapper {
      display: flex;
      justify-content: center;
    }
  </style>
</head>
<body>

  <!-- Floating Nav Bar -->
  <nav class="nav-bar">
    <a href="/" style="display: flex; align-items: center; text-decoration: none;">
      <Logo variant="horizontal" size={32} client:load />
    </a>

    <ul class="nav-links">
      <li><a href="#architecture" class="nav-link">Architecture</a></li>
      <li><a href="#features" class="nav-link">Features</a></li>
      <li><a href="#compare" class="nav-link">Benchmarks</a></li>
      <li><a href="https://docs.10xgraph.com" class="nav-link">Documentation</a></li>
    </ul>

    <div class="nav-actions">
      <button class="cmd-k-trigger" onclick="window.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', metaKey: true }))">
        <span>Search</span>
        <kbd style="padding: 0.1rem 0.3rem; background: rgba(255,255,255,0.08); border-radius: 4px;">⌘K</kbd>
      </button>

      <a href="https://docs.10xgraph.com" style="text-decoration: none;">
        <Button size="sm" variant="primary" client:load>
          Read Docs →
        </Button>
      </a>
    </div>
  </nav>

  <!-- Hero Section with Live Living Graph Canvas -->
  <div class="hero-container bg-grid-graph">
    <div class="hero-canvas-wrap">
      <GraphCanvas
        client:load
        nodeCount={24}
        maxDistance={170}
        theme="dark"
        interactive={true}
      />
    </div>

    <div class="hero-content">
      <div class="badge-pill">
        <span style="width: 7px; height: 7px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 8px var(--signal);"></span>
        10xGraph Engine • v0.9.2 Architecture
      </div>

      <h1 class="hero-title">
        The Living Graph for <span class="accent">Autonomous AI</span>
      </h1>

      <p class="hero-desc">
        Orchestrate multi-agent clusters across directed state graphs. Built for deterministic replay, time-travel checkpoints, and sub-millisecond execution telemetry.
      </p>

      <div class="hero-actions">
        <a href="https://docs.10xgraph.com/get-started/first-agent" style="text-decoration: none;">
          <Button size="lg" variant="primary" client:load>
            Build Your First Agent →
          </Button>
        </a>
        <a href="https://github.com/10xGraph" target="_blank" rel="noopener noreferrer" style="text-decoration: none;">
          <Button size="lg" variant="ghost" client:load>
            GitHub (10xGraph)
          </Button>
        </a>
      </div>

      <div class="hero-install-wrapper">
        <InstallPill command="pip install 10xgraph 10xgraph-api" prefix="$" client:load />
      </div>
    </div>
  </div>

  <!-- Section 3: Ecosystem Marquee Strip -->
  <EcosystemStrip />

  <!-- Section 4: Code to Production Interactive Pipeline -->
  <CodeToProduction />

  <!-- Section 5: Feature Bento Grid (6 Live Superpower Tiles) -->
  <FeatureBento />

  <!-- Section 9: Framework Comparison Matrix -->
  <CompareMatrix />

  <!-- Section 10: Final Conversion CTA -->
  <FinalCta />

  <!-- Section 11: Landing Footer -->
  <Footer />

  <!-- Global Command Palette (⌘K) -->
  <CommandPalette client:idle />

</body>
</html>
