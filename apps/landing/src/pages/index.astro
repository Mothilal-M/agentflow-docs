---
// apps/landing/src/pages/index.astro
import { CommandPalette, InstallPill } from '@10xgraph/ui';
import EcosystemStrip from '../components/EcosystemStrip.astro';
import CodeToProduction from '../components/CodeToProduction.astro';
import FeatureBento from '../components/FeatureBento.astro';
import CompareMatrix from '../components/CompareMatrix.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>10xGraph - State-Graph Engine for Autonomous AI Agents</title>
  <meta name="description" content="Build deterministic AI agent graphs in Python. 10xGraph automatically generates production FastAPI servers with durable Redis checkpoints, JWT auth, and replay-safe tool ledgers." />
  <link rel="icon" type="image/jpeg" href="/logo/10xgraph-icon-badge.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --primary: #005be6;
      --primary-hover: #1e40af;
      --primary-wash: #dfecff;
      --bg: #ffffff;
      --surface-soft: #f8fafc;
      --border: #e2e8f0;
      --text: #0d0d0d;
      --text-muted: #6b7280;
      --font-display: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-display);
      overflow-x: hidden;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* Header Nav */
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 40;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }
    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
      height: 4.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
    }
    .brand-logo-img {
      height: 34px;
      width: auto;
      object-fit: contain;
    }
    .nav-links {
      display: none;
      align-items: center;
      gap: 2rem;
      list-style: none;
    }
    @media (min-width: 768px) {
      .nav-links {
        display: flex;
      }
    }
    .nav-link {
      color: var(--text-muted);
      font-size: 0.9rem;
      font-weight: 500;
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .nav-link:hover {
      color: var(--primary);
    }
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .btn-github {
      display: none;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 1rem;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: #ffffff;
      color: #374151;
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s ease;
    }
    @media (min-width: 640px) {
      .btn-github {
        display: inline-flex;
      }
    }
    .btn-github:hover {
      background: var(--surface-soft);
    }
    .github-star-pill {
      padding: 0.1rem 0.4rem;
      background: #f1f5f9;
      border-radius: 4px;
      font-size: 0.75rem;
      color: #64748b;
      font-family: var(--font-mono);
    }
    .btn-cta-nav {
      display: inline-flex;
      align-items: center;
      padding: 0.55rem 1.25rem;
      border-radius: 12px;
      background: var(--primary);
      color: #ffffff;
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
      transition: all 0.15s ease;
    }
    .btn-cta-nav:hover {
      background: var(--primary-hover);
      box-shadow: 0 4px 12px rgba(0, 91, 230, 0.2);
    }

    /* Hero Section */
    .hero-section {
      padding: 4.5rem 0 5.5rem;
      overflow: hidden;
    }
    .hero-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 3.5rem;
      align-items: center;
    }
    @media (min-width: 1024px) {
      .hero-grid {
        grid-template-columns: 5fr 7fr;
        gap: 3rem;
      }
    }

    /* Hero Left Copy */
    .hero-copy {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .eyebrow-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      background: var(--primary-wash);
      color: var(--primary);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      width: fit-content;
    }
    .eyebrow-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--primary);
    }
    .hero-headline {
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      line-height: 1.1;
      color: #0d0d0d;
    }
    .hero-headline-accent {
      color: var(--primary);
    }
    .hero-lead {
      font-size: 1.1rem;
      line-height: 1.65;
      color: var(--text-muted);
      max-width: 520px;
    }
    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
      padding-top: 0.5rem;
    }
    .btn-hero-primary {
      padding: 0.85rem 1.75rem;
      border-radius: 12px;
      background: var(--primary);
      color: #ffffff;
      font-size: 0.95rem;
      font-weight: 600;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(0, 91, 230, 0.25);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .btn-hero-primary:hover {
      background: var(--primary-hover);
      box-shadow: 0 6px 20px rgba(0, 91, 230, 0.35);
      transform: translateY(-1px);
    }
    .btn-hero-outline {
      padding: 0.85rem 1.5rem;
      border-radius: 12px;
      background: #ffffff;
      border: 1px solid var(--border);
      color: #374151;
      font-size: 0.95rem;
      font-weight: 600;
      text-decoration: none;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      transition: all 0.2s ease;
    }
    .btn-hero-outline:hover {
      background: var(--surface-soft);
      border-color: #cbd5e1;
    }

    /* Product Mockup (Hero Right) */
    .mockup-window {
      border-radius: 16px;
      background: #ffffff;
      border: 1px solid var(--border);
      box-shadow: 0 25px 50px -12px rgba(0, 91, 230, 0.12), 0 0 0 1px rgba(226, 232, 240, 0.9);
      overflow: hidden;
    }
    .mockup-topbar {
      background: var(--surface-soft);
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .mockup-dots {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .mockup-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }
    .dot-red { background: #ff5f56; }
    .dot-yellow { background: #ffbd2e; }
    .dot-green { background: #27c93f; }
    .mockup-title {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-muted);
      margin-left: 0.6rem;
      font-weight: 500;
    }
    .mockup-actions {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }
    .live-badge {
      display: inline-flex;
      align-items: center;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      background: #ecfdf5;
      color: #10b981;
      font-size: 0.68rem;
      font-weight: 700;
      border: 1px solid #a7f3d0;
    }
    .deploy-btn {
      padding: 0.25rem 0.75rem;
      border-radius: 6px;
      background: var(--primary);
      color: #ffffff;
      font-size: 0.72rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
    }

    .mockup-body {
      display: grid;
      grid-template-columns: 1fr;
      min-height: 380px;
    }
    @media (min-width: 640px) {
      .mockup-body {
        grid-template-columns: 8fr 4fr;
      }
    }

    /* Mockup Graph Canvas */
    .mockup-canvas {
      padding: 1.5rem;
      position: relative;
      border-right: 1px solid var(--border);
      background-image: linear-gradient(to right, rgba(0, 91, 230, 0.04) 1px, transparent 1px),
                        linear-gradient(to bottom, rgba(0, 91, 230, 0.04) 1px, transparent 1px);
      background-size: 24px 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .canvas-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-muted);
    }
    .canvas-accent {
      color: var(--primary);
    }
    .canvas-pipeline {
      margin: auto 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
      padding: 1rem 0;
    }
    .canvas-node {
      padding: 0.55rem 1rem;
      border-radius: 10px;
      background: #ffffff;
      border: 1px solid var(--border);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      font-weight: 700;
      color: #0d0d0d;
    }
    .node-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #94a3b8;
    }
    .canvas-edge {
      width: 2px;
      height: 20px;
      background: var(--primary);
      position: relative;
    }
    .pulse-packet {
      position: absolute;
      top: 50%;
      left: -3px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--primary);
      animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    .node-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
      max-width: 320px;
      width: 100%;
    }
    .split-card {
      padding: 0.6rem;
      border-radius: 10px;
      text-align: center;
      border: 1px solid var(--border);
      background: #ffffff;
    }
    .split-card.active {
      background: #dfecff;
      border-color: rgba(0, 91, 230, 0.4);
    }
    .split-name {
      font-size: 0.72rem;
      font-weight: 700;
      color: #0d0d0d;
    }
    .split-card.active .split-name {
      color: var(--primary);
    }
    .split-meta {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      color: var(--text-muted);
      margin-top: 0.2rem;
    }
    .node-output {
      padding: 0.6rem 1.25rem;
      border-radius: 10px;
      background: var(--primary);
      color: #ffffff;
      box-shadow: 0 4px 10px rgba(0, 91, 230, 0.2);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      font-weight: 700;
    }
    .output-status {
      padding: 0.1rem 0.35rem;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.2);
      font-family: var(--font-mono);
      font-size: 0.65rem;
    }
    .canvas-footer {
      display: flex;
      justify-content: space-between;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--text-muted);
    }

    /* Mockup Telemetry Drawer */
    .mockup-telemetry {
      background: var(--surface-soft);
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      font-size: 0.75rem;
    }
    .tel-heading {
      font-weight: 800;
      color: #4b5563;
      letter-spacing: 0.05em;
      font-size: 0.68rem;
      text-transform: uppercase;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.5rem;
      margin-bottom: 0.85rem;
    }
    .tel-list {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      font-family: var(--font-mono);
    }
    .tel-row-label {
      font-size: 0.62rem;
      color: var(--text-muted);
    }
    .tel-row-val {
      font-weight: 700;
      color: #0d0d0d;
      font-size: 0.75rem;
    }
    .tel-row-val.accent {
      color: var(--primary);
    }
    .tel-status-pill {
      display: inline-block;
      padding: 0.1rem 0.4rem;
      border-radius: 4px;
      background: #ecfdf5;
      color: #10b981;
      font-size: 0.65rem;
      font-weight: 800;
    }
    .tel-cache-note {
      padding-top: 0.85rem;
      border-top: 1px solid var(--border);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--text-muted);
    }

    @keyframes ping {
      75%, 100% {
        transform: scale(2);
        opacity: 0;
      }
    }
  </style>
</head>
<body>

  <!-- STICKY NAVBAR -->
  <header class="site-nav">
    <div class="nav-container">
      <a href="/" class="brand-link" aria-label="10xGraph Home">
        <img
          src="/logo/10xgraph-logo-3d.png"
          alt="10xGraph Logo"
          class="brand-logo-img"
        />
      </a>

      <nav aria-label="Main Navigation">
        <ul class="nav-links">
          <li><a href="#how-it-works" class="nav-link">How it works</a></li>
          <li><a href="#features" class="nav-link">Features</a></li>
          <li><a href="#compare" class="nav-link">Benchmarks</a></li>
          <li><a href="https://docs.10xgraph.com" class="nav-link">Documentation</a></li>
        </ul>
      </nav>

      <div class="nav-actions">
        <a href="https://github.com/10xGraph" target="_blank" rel="noopener noreferrer" class="btn-github">
          <span>GitHub</span>
          <span class="github-star-pill">★</span>
        </a>
        <a href="https://docs.10xgraph.com/get-started/first-agent" class="btn-cta-nav">
          Get Started Free
        </a>
      </div>
    </div>
  </header>

  <!-- HERO SECTION -->
  <section class="hero-section" id="hero">
    <div class="hero-container">
      <div class="hero-grid">
        
        <!-- Left: Headline & Controls (5 Cols) -->
        <div class="hero-copy">
          <div class="eyebrow-badge">
            <span class="eyebrow-dot"></span>
            <span>v0.9.2 • Production Multi-Agent Engine</span>
          </div>

          <h1 class="hero-headline">
            Build deterministic AI agent graphs. <span class="hero-headline-accent">Run them on production infrastructure.</span>
          </h1>

          <p class="hero-lead">
            10xGraph compiles your typed Python state graphs into self-hosted FastAPI servers with durable Redis checkpoints, JWT auth, and replay-safe tool ledgers.
          </p>

          <div class="hero-buttons">
            <a href="https://docs.10xgraph.com/get-started/first-agent" class="btn-hero-primary">
              <span>Start Building Free</span>
              <span>→</span>
            </a>
            <a href="https://docs.10xgraph.com" class="btn-hero-outline">
              View Documentation
            </a>
          </div>

          <div class="pt-2">
            <InstallPill command="pip install 10xgraph 10xgraph-api" prefix="$" client:visible />
          </div>
        </div>

        <!-- Right: Authentic Product UI Mockup (7 Cols) -->
        <div class="mockup-window" id="mockup-section">
          <!-- Window Topbar Chrome -->
          <div class="mockup-topbar">
            <div class="mockup-dots">
              <span class="mockup-dot dot-red"></span>
              <span class="mockup-dot dot-yellow"></span>
              <span class="mockup-dot dot-green"></span>
              <span class="mockup-title">10xgraph-studio • data-analysis-agent</span>
            </div>
            <div class="mockup-actions">
              <span class="live-badge">● LIVE RUNTIME</span>
              <button class="deploy-btn">Deploy</button>
            </div>
          </div>

          <!-- Mockup Body -->
          <div class="mockup-body">
            
            <!-- Left: Graph Flow Canvas -->
            <div class="mockup-canvas">
              <div class="canvas-header">
                <span>StateGraph Topology</span>
                <span class="canvas-accent">Replay-Safe Checkpoints</span>
              </div>

              <!-- Pipeline Nodes -->
              <div class="canvas-pipeline">
                <div class="canvas-node">
                  <span class="node-dot"></span>
                  <span>User Request Ingest</span>
                </div>

                <div class="canvas-edge">
                  <div class="pulse-packet"></div>
                </div>

                <div class="node-split">
                  <div class="split-card active">
                    <div class="split-name">LLM Evaluator</div>
                    <div class="split-meta">Gemini 2.5 Pro</div>
                  </div>
                  <div class="split-card">
                    <div class="split-name">Tool Dispatcher</div>
                    <div class="split-meta">lookup_order()</div>
                  </div>
                </div>

                <div class="canvas-edge"></div>

                <div class="node-output">
                  <span>Committed Response</span>
                  <span class="output-status">200 OK</span>
                </div>
              </div>

              <div class="canvas-footer">
                <span>Thread: th_9x28fa</span>
                <span>Ledger: 3 commits</span>
              </div>
            </div>

            <!-- Right: Telemetry Drawer -->
            <div class="mockup-telemetry">
              <div>
                <div class="tel-heading">Execution Telemetry</div>
                <div class="tel-list">
                  <div>
                    <div class="tel-row-label">ACTIVE NODE</div>
                    <div class="tel-row-val">LLM_Evaluator</div>
                  </div>
                  <div>
                    <div class="tel-row-label">STEP LATENCY</div>
                    <div class="tel-row-val accent">145ms</div>
                  </div>
                  <div>
                    <div class="tel-row-label">CONTEXT TOKENS</div>
                    <div class="tel-row-val">1,850 tok</div>
                  </div>
                  <div>
                    <div class="tel-row-label">EXECUTION TIME</div>
                    <div class="tel-row-val">2.1s total</div>
                  </div>
                  <div>
                    <div class="tel-row-label">CHECKPOINT STATUS</div>
                    <div class="tel-status-pill">SUCCESS</div>
                  </div>
                </div>
              </div>

              <div class="tel-cache-note">
                Redis Hot Cache: 0.8ms
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ECOSYSTEM STRIP -->
  <EcosystemStrip />

  <!-- ARCHITECTURE & PIPELINE STEPPER -->
  <CodeToProduction />

  <!-- FEATURE BENTO (6 TILES) -->
  <FeatureBento />

  <!-- BENCHMARK / COMPARISON MATRIX -->
  <CompareMatrix />

  <!-- FINAL CTA -->
  <FinalCta />

  <!-- FOOTER -->
  <Footer />

  <!-- COMMAND PALETTE MODAL -->
  <CommandPalette client:idle />

</body>
</html>
