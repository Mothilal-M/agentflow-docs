---
// apps/landing/src/pages/404.astro
import { Button } from '@10xgraph/ui';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404 - State Disconnected | 10xGraph</title>
  <link rel="icon" type="image/jpeg" href="/logo/10xgraph-icon-badge.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet" />
  <style>
    body {
      background: #ffffff;
      color: #0d0d0d;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      margin: 0;
    }
    .nf-container {
      max-width: 600px;
    }
    .nf-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.75rem;
      font-weight: 700;
      color: #e14942;
      background: #fef2f2;
      border: 1px solid rgba(225, 73, 66, 0.25);
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      display: inline-block;
      margin-bottom: 1.5rem;
    }
    .nf-title {
      font-size: clamp(2.25rem, 5vw, 3.5rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      margin-bottom: 1rem;
    }
    .nf-desc {
      font-size: 1.05rem;
      color: #6b7280;
      line-height: 1.6;
      margin-bottom: 2.5rem;
    }
    .nf-actions {
      display: flex;
      justify-content: center;
      gap: 1rem;
    }
    .nf-badge-img {
      width: 72px;
      height: 72px;
      border-radius: 18px;
      box-shadow: 0 10px 25px rgba(0, 91, 230, 0.15);
      margin-bottom: 2rem;
    }
  </style>
</head>
<body>
  <div class="nf-container">
    <img
      src="/logo/10xgraph-icon-badge.jpg"
      alt="10xGraph Icon"
      class="nf-badge-img"
    />

    <div>
      <span class="nf-tag">ERROR 404 • UNRESOLVED STATE NODE</span>
    </div>
    <h1 class="nf-title">This Route Leads Nowhere</h1>
    <p class="nf-desc">
      The state machine encountered an unmapped transition or dead edge. Return to the homepage or explore documentation.
    </p>

    <div class="nf-actions">
      <a href="/" style="text-decoration: none;">
        <Button size="md" variant="primary" client:load>Return Home →</Button>
      </a>
      <a href="https://docs.10xgraph.com" style="text-decoration: none;">
        <Button size="md" variant="outline" client:load>Documentation</Button>
      </a>
    </div>
  </div>
</body>
</html>
