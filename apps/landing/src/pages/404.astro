---
import { Logo, Button } from '@10xgraph/ui';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404 - State Disconnected | 10xGraph</title>
  <link rel="stylesheet" href="/node_modules/@10xgraph/ui/src/tokens.css" />
  <link rel="stylesheet" href="/node_modules/@10xgraph/ui/src/fonts.css" />
  <style>
    @import "@10xgraph/ui/tokens.css";
    @import "@10xgraph/ui/fonts.css";

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      margin: 0;
    }
    .nf-container {
      max-width: 600px;
    }
    .nf-tag {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--danger);
      background: rgba(255, 107, 107, 0.1);
      border: 1px solid rgba(255, 107, 107, 0.25);
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      display: inline-block;
      margin-bottom: 1.5rem;
    }
    .nf-title {
      font-family: var(--font-display);
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 800;
      letter-spacing: -0.035em;
      margin-bottom: 1rem;
    }
    .nf-desc {
      font-size: 1.1rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 2.5rem;
    }
    .nf-actions {
      display: flex;
      justify-content: center;
      gap: 1rem;
    }
  </style>
</head>
<body class="bg-grid-graph">
  <div class="nf-container">
    <div style="margin-bottom: 2rem;">
      <Logo variant="mark" size={64} client:load />
    </div>

    <span class="nf-tag">ERROR 404 • UNRESOLVED STATE NODE</span>
    <h1 class="nf-title">This Route Leads Nowhere</h1>
    <p class="nf-desc">
      The state machine encountered an unmapped transition or dead edge. Return to the homepage or explore documentation.
    </p>

    <div class="nf-actions">
      <a href="/" style="text-decoration: none;">
        <Button size="md" variant="primary" client:load>Return Home →</Button>
      </a>
      <a href="https://docs.10xgraph.com" style="text-decoration: none;">
        <Button size="md" variant="ghost" client:load>Documentation</Button>
      </a>
    </div>
  </div>
</body>
</html>
