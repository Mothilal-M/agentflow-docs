---
// apps/landing/src/components/EcosystemStrip.astro
const providers = [
  { name: 'Google Gemini', tag: 'Native LLM' },
  { name: 'Anthropic Claude', tag: 'Native LLM' },
  { name: 'OpenAI GPT-4o', tag: 'Native LLM' },
  { name: 'FastAPI', tag: 'Compiled API Server' },
  { name: 'Redis', tag: 'Hot Memory Cache' },
  { name: 'PostgreSQL', tag: 'Cold State Store' },
  { name: 'Docker', tag: 'Container Build' },
  { name: 'Kubernetes', tag: 'Production Specs' },
];
---

<section class="ecosystem-section">
  <div class="ecosystem-container">
    <p class="ecosystem-label">NATIVELY COMPATIBLE WITH THE MODERN PRODUCTION STACK</p>
    
    <div class="marquee-track">
      <div class="marquee-content">
        {providers.concat(providers).map((p) => (
          <div class="ecosystem-chip">
            <span class="chip-dot"></span>
            <span class="chip-name">{p.name}</span>
            <span class="chip-tag">{p.tag}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ecosystem-section {
    padding: 3rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: #f8fafc;
    overflow: hidden;
  }
  .ecosystem-container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  .ecosystem-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    margin-bottom: 1.5rem;
  }
  .marquee-track {
    display: flex;
    overflow: hidden;
    user-select: none;
    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
  }
  .marquee-content {
    display: flex;
    gap: 1.25rem;
    animation: marquee 35s linear infinite;
    min-width: 100%;
  }
  .marquee-track:hover .marquee-content {
    animation-play-state: paused;
  }
  .ecosystem-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.1rem;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 9999px;
    white-space: nowrap;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ecosystem-chip:hover {
    border-color: #005be6;
    box-shadow: 0 4px 12px rgba(0, 91, 230, 0.12);
    transform: translateY(-2px);
  }
  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #005be6;
  }
  .chip-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: #0d0d0d;
  }
  .chip-tag {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    padding: 0.1rem 0.4rem;
    background: #f1f5f9;
    border-radius: 4px;
  }

  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
</style>
