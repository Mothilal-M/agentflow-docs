---
// apps/landing/src/components/CompareMatrix.astro
const features = [
  {
    feature: 'License',
    xgraph: 'MIT (100% Free & Open Source)',
    langgraph: 'MIT (Server is Proprietary Cloud)',
    crewai: 'MIT (Enterprise Cloud Features)',
    winner: true,
  },
  {
    feature: 'Production Server Included',
    xgraph: 'Built-in (FastAPI + JWT + RBAC)',
    langgraph: 'Requires LangSmith Managed Cloud',
    crewai: 'Separate CrewAI Enterprise Server',
    winner: true,
  },
  {
    feature: 'Replay-Safe Tool Ledger',
    xgraph: 'Native (No double-execution on crash)',
    langgraph: 'Custom checkpointer implementation',
    crewai: 'Basic session replay',
    winner: true,
  },
  {
    feature: 'Framework Dependencies',
    xgraph: 'Zero (No LangChain dependency)',
    langgraph: 'Requires langchain-core',
    crewai: 'Heavy ecosystem dependencies',
    winner: true,
  },
  {
    feature: 'Two-Tier Memory Architecture',
    xgraph: 'Redis Hot Cache + Postgres History',
    langgraph: 'Requires manual store wiring',
    crewai: 'Chroma / custom vector setup',
    winner: true,
  },
  {
    feature: 'Deployment Artifacts',
    xgraph: 'Auto-generated Docker & Kubernetes specs',
    langgraph: 'Cloud Deployment only',
    crewai: 'Manual containerization',
    winner: true,
  },
];
---

<section class="compare-section" id="compare">
  <div class="compare-container">
    <div class="compare-header">
      <span class="compare-tag">ARCHITECTURAL BENCHMARKS</span>
      <h2 class="compare-title">Why Teams Choose 10xGraph Over Complex Legacy Frameworks</h2>
      <p class="compare-desc">
        We believe developer infrastructure should belong to you. No closed server tiers, no proprietary cloud locks, and zero framework bloat.
      </p>
    </div>

    <div class="compare-table-wrapper">
      <table class="compare-table">
        <thead>
          <tr>
            <th class="th-feature">Capability</th>
            <th class="th-xgraph">
              <div class="th-brand">
                <span class="dot-signal"></span>
                <span>10xGraph</span>
              </div>
            </th>
            <th class="th-other">LangGraph</th>
            <th class="th-other">CrewAI</th>
          </tr>
        </thead>
        <tbody>
          {features.map((row) => (
            <tr>
              <td class="td-feature">{row.feature}</td>
              <td class="td-xgraph">
                <span class="check-icon">✓</span>
                <span>{row.xgraph}</span>
              </td>
              <td class="td-other">{row.langgraph}</td>
              <td class="td-other">{row.crewai}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .compare-section {
    padding: 6rem 1.5rem;
    background: #ffffff;
  }
  .compare-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .compare-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem;
  }
  .compare-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    color: #005be6;
    letter-spacing: 0.1em;
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: #dfecff;
    border-radius: 9999px;
    margin-bottom: 1rem;
  }
  .compare-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: #0d0d0d;
    margin-bottom: 1rem;
  }
  .compare-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .compare-table-wrapper {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 700px;
  }
  th {
    padding: 1.25rem 1.5rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    border-bottom: 1px solid var(--border);
    background: #f8fafc;
  }
  .th-feature {
    color: var(--text-muted);
    width: 25%;
  }
  .th-xgraph {
    background: #dfecff;
    color: #005be6;
    width: 35%;
  }
  .th-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 800;
  }
  .dot-signal {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #005be6;
  }
  .th-other {
    color: var(--text-muted);
    width: 20%;
  }
  td {
    padding: 1.1rem 1.5rem;
    font-size: 0.88rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  tr:last-child td {
    border-bottom: none;
  }
  .td-feature {
    font-weight: 600;
    color: #0d0d0d;
  }
  .td-xgraph {
    background: #f0f7ff;
    color: #005be6;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .check-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #005be6;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 900;
    shrink-0: 0;
  }
  .td-other {
    color: var(--text-muted);
    font-size: 0.82rem;
  }
</style>
