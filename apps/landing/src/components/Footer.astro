---
// apps/landing/src/components/Footer.astro
const year = new Date().getFullYear();
---

<footer class="landing-footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="brand-link">
          <img
            src="/logo/10xgraph-logo-3d.png"
            alt="10xGraph"
            height="32"
            class="brand-logo"
          />
        </a>
        <p class="brand-tagline">
          The Living Graph: Open-source Python multi-agent state graph runtime with built-in production API server, JWT auth, and replay checkpoints.
        </p>
        <div class="status-indicator-wrap">
          <span class="status-dot"></span>
          <span>Engine v0.9.2 • Production Ready</span>
        </div>
      </div>

      <div class="footer-links-grid">
        <div class="links-col">
          <h4>Documentation</h4>
          <ul>
            <li><a href="https://docs.10xgraph.com/get-started/installation">Installation</a></li>
            <li><a href="https://docs.10xgraph.com/get-started/first-agent">First Agent</a></li>
            <li><a href="https://docs.10xgraph.com/concepts/state-graph">State Graph</a></li>
            <li><a href="https://docs.10xgraph.com/concepts/memory">Memory &amp; Checkpoints</a></li>
          </ul>
        </div>

        <div class="links-col">
          <h4>Framework</h4>
          <ul>
            <li><a href="https://docs.10xgraph.com/compare/agentflow-vs-langgraph">vs. LangGraph</a></li>
            <li><a href="https://docs.10xgraph.com/compare/agentflow-vs-crewai">vs. CrewAI</a></li>
            <li><a href="https://docs.10xgraph.com/reference/python">Python Reference</a></li>
            <li><a href="https://docs.10xgraph.com/reference/client">TypeScript SDK</a></li>
          </ul>
        </div>

        <div class="links-col">
          <h4>Community &amp; Code</h4>
          <ul>
            <li><a href="https://github.com/10xGraph" target="_blank" rel="noopener noreferrer">GitHub Org</a></li>
            <li><a href="https://github.com/10xGraph/10xgraph-docs" target="_blank" rel="noopener noreferrer">Docs Source</a></li>
            <li><a href="https://docs.10xgraph.com/changelog">Changelog</a></li>
            <li><a href="https://docs.10xgraph.com/llms.txt">llms.txt (AI Index)</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} 10xScale. 10xGraph is free and open-source software under the MIT License.</p>
      <p class="footer-formerly">Formerly published as Agentflow.</p>
    </div>
  </div>
</footer>

<style>
  .landing-footer {
    padding: 5rem 1.5rem 3rem;
    background: #020409;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  @media (min-width: 860px) {
    .footer-top {
      grid-template-columns: 1.25fr 2fr;
    }
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .brand-logo {
    height: 32px;
    object-fit: contain;
  }
  .brand-tagline {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #94a3b8;
    max-width: 360px;
  }
  .status-indicator-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: #cbd5e1;
  }
  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }
  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 2.5rem;
  }
  .links-col h4 {
    font-family: var(--font-display, sans-serif);
    font-size: 0.82rem;
    font-weight: 800;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
  }
  .links-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .links-col a {
    color: #94a3b8;
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .links-col a:hover {
    color: #38bdf8;
  }
  .footer-bottom {
    padding-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: #64748b;
  }
  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
    }
  }
  .footer-formerly {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: #475569;
  }
</style>
