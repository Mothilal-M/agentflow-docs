---
// apps/landing/src/components/CodeToProduction.astro
---

<section class="c2p-section" id="how-it-works">
  <div class="c2p-container">
    <div class="c2p-header">
      <div class="c2p-badge">
        <span class="c2p-badge-dot"></span>
        <span>CODE TO PRODUCTION PIPELINE</span>
      </div>
      <h2 class="c2p-title">You Write The State Graph. 10xGraph Generates Everything Else.</h2>
      <p class="c2p-desc">
        Stop duct-taping API servers, session management, and auth tokens. Define your agent routines once in Python—10xGraph compiles the graph, injects durable checkpoints, and deploys the production FastAPI server.
      </p>
    </div>

    <div class="c2p-grid">
      <!-- Left: Interactive Code Editor Window -->
      <div class="c2p-editor-frame">
        <div class="c2p-editor-topbar">
          <div class="editor-dots">
            <span class="dot-red"></span>
            <span class="dot-yellow"></span>
            <span class="dot-green"></span>
          </div>
          
          <div class="editor-tabs">
            <button class="editor-tab active" data-tab="react">agent_graph.py</button>
            <button class="editor-tab" data-tab="swarm">swarm_router.py</button>
            <button class="editor-tab" data-tab="server">server_api.py</button>
          </div>

          <span class="editor-lang">Python 3.12+</span>
        </div>

        <!-- Tab 1: ReactAgent -->
        <pre class="c2p-code code-tab" id="code-react"><code><span class="c-kw">from</span> 10xgraph <span class="c-kw">import</span> StateGraph, ReactAgent, tool
<span class="c-kw">from</span> pydantic <span class="c-kw">import</span> BaseModel

<span class="c-dec">@tool(permissions=["billing:write"])</span>
<span class="c-kw">async def</span> <span class="c-fn">dispatch_refund</span>(order_id: <span class="c-type">str</span>, amount: <span class="c-type">float</span>) -&gt; <span class="c-type">str</span>:
    <span class="c-doc">"""Executes refund through gateway with ledger replay-safety."""</span>
    <span class="c-kw">return</span> <span class="c-str">f"Approved refund of &#36;&#123;amount&#125; for order &#123;order_id&#125;"</span>

<span class="c-cmt"># Compile state graph with durable Redis checkpointing</span>
agent = ReactAgent(
    model=<span class="c-str">"gemini-2.5-pro"</span>,
    tools=[dispatch_refund],
    checkpointer=<span class="c-str">"redis://localhost:6379"</span>,
    max_steps=10
)

<span class="c-cmt"># Generates FastAPI server with JWT &amp; Docker/k8s specs</span>
app = agent.to_production_server()</code></pre>

        <!-- Tab 2: Swarm Router -->
        <pre class="c2p-code code-tab" id="code-swarm" style="display: none;"><code><span class="c-kw">from</span> 10xgraph <span class="c-kw">import</span> SwarmCluster, AgentNode

<span class="c-cmt"># Define specialist nodes with typed state contracts</span>
router = AgentNode(name=<span class="c-str">"router"</span>, model=<span class="c-str">"gemini-2.5-flash"</span>)
analyst = AgentNode(name=<span class="c-str">"analyst"</span>, model=<span class="c-str">"gemini-2.5-pro"</span>, tools=[calc_risk])
auditor = AgentNode(name=<span class="c-str">"auditor"</span>, model=<span class="c-str">"claude-3-5-sonnet"</span>)

<span class="c-cmt"># Assemble autonomous swarm with deterministic handoffs</span>
swarm = SwarmCluster()
swarm.add_edge(router, analyst, condition=<span class="c-str">"requires_deep_calc"</span>)
swarm.add_edge(analyst, auditor, condition=<span class="c-str">"verify_compliance"</span>)

<span class="c-cmt"># Deploy swarm cluster with durable state replay</span>
app = swarm.to_production_server(port=8000)</code></pre>

        <!-- Tab 3: Server API -->
        <pre class="c2p-code code-tab" id="code-server" style="display: none;"><code><span class="c-kw">import</span> uvicorn
<span class="c-kw">from</span> 10xgraph.server <span class="c-kw">import</span> create_agent_service

<span class="c-cmt"># Auto-generates REST, SSE streams, JWT validation and metrics</span>
service = create_agent_service(
    agent_graph=agent,
    jwt_secret=<span class="c-str">"env:JWT_SECRET_KEY"</span>,
    rate_limit=<span class="c-str">"120/minute"</span>,
    enable_sse_stream=<span class="c-kw">True</span>
)

<span class="c-kw">if</span> __name__ == <span class="c-str">"__main__"</span>:
    <span class="c-cmt"># Ready for Kubernetes horizontal pod autoscaling</span>
    uvicorn.run(service, host=<span class="c-str">"0.0.0.0"</span>, port=8000)</code></pre>
      </div>

      <!-- Right: Interactive State Visualizer -->
      <div class="c2p-graph-frame">
        <div class="graph-topbar">
          <div class="graph-status">
            <span class="status-indicator"></span>
            <span>COMPILED GRAPH TOPOLOGY</span>
          </div>
          <span class="graph-meta">2 Nodes • 3 Edges • Replay-Safe</span>
        </div>

        <div class="graph-interactive-body">
          <div class="pipeline-step">
            <div class="step-badge">INPUT</div>
            <div class="step-card">
              <span class="card-name">HTTP / SSE Ingest</span>
              <span class="card-sub">Bearer JWT • Rate Limit Check</span>
            </div>
          </div>

          <div class="pipeline-edge">
            <div class="edge-packet packet-1"></div>
          </div>

          <div class="pipeline-step">
            <div class="step-badge accent-primary">AGENT NODE</div>
            <div class="step-card active-card">
              <span class="card-name">LLM Evaluator (Gemini 2.5)</span>
              <span class="card-sub">Tool Call Generation • Context Window: 1M</span>
            </div>
          </div>

          <div class="pipeline-edge">
            <div class="edge-packet packet-2"></div>
          </div>

          <div class="pipeline-step">
            <div class="step-badge accent-green">STATE CHECKPOINT</div>
            <div class="step-card checkpoint-card">
              <span class="card-name">Durable Redis Ledger</span>
              <span class="card-sub">Snapshot Commit &lt; 0.8ms • Replay Guard</span>
            </div>
          </div>
        </div>

        <div class="graph-footer-telemetry">
          <div class="telemetry-item">
            <span class="tel-label">Avg Step Latency</span>
            <span class="tel-val text-primary">145ms</span>
          </div>
          <div class="telemetry-item">
            <span class="tel-label">Hot Cache Read</span>
            <span class="tel-val text-primary">&lt; 0.8ms</span>
          </div>
          <div class="telemetry-item">
            <span class="tel-label">Fault Recovery</span>
            <span class="tel-val text-green">100% Deterministic</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Tab switching logic for code editor
  const tabs = document.querySelectorAll('.editor-tab');
  const codePanes = document.querySelectorAll('.code-tab');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.classList.remove('active'));
      tab.classList.add('active');

      const target = (tab as HTMLElement).dataset.tab;
      codePanes.forEach((pane) => {
        if (pane.id === `code-${target}`) {
          (pane as HTMLElement).style.display = 'block';
        } else {
          (pane as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .c2p-section {
    padding: 7rem 1.5rem;
    background: #f8fafc;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .c2p-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .c2p-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 4.5rem;
  }
  .c2p-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    font-weight: 800;
    color: #005be6;
    letter-spacing: 0.1em;
    padding: 0.35rem 0.85rem;
    background: #dfecff;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
  }
  .c2p-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #005be6;
  }
  .c2p-title {
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: #0d0d0d;
    margin-bottom: 1rem;
  }
  .c2p-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .c2p-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 960px) {
    .c2p-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  /* Editor Frame */
  .c2p-editor-frame {
    border-radius: 18px;
    background: #0f172a;
    border: 1px solid #334155;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
  }
  .c2p-editor-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background: #1e293b;
    border-bottom: 1px solid #334155;
  }
  .editor-dots {
    display: flex;
    gap: 0.4rem;
  }
  .editor-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot-red { background: #ff5f56; }
  .dot-yellow { background: #ffbd2e; }
  .dot-green { background: #27c93f; }

  .editor-tabs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: #0f172a;
    padding: 0.2rem;
    border-radius: 8px;
  }
  .editor-tab {
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    border: none;
    background: transparent;
    color: #94a3b8;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .editor-tab.active {
    background: #1e293b;
    color: #38bdf8;
  }
  .editor-tab:hover {
    color: #ffffff;
  }

  .editor-lang {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: #64748b;
  }
  .c2p-code {
    padding: 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.86rem;
    line-height: 1.7;
    overflow-x: auto;
    margin: 0;
    color: #e2e8f0;
  }
  .c-kw { color: #f472b6; font-weight: 600; }
  .c-fn { color: #60a5fa; font-weight: 600; }
  .c-dec { color: #38bdf8; }
  .c-doc { color: #94a3b8; font-style: italic; }
  .c-cmt { color: #64748b; font-style: italic; }
  .c-str { color: #a7f3d0; }
  .c-type { color: #fbbf24; }

  /* Graph Frame */
  .c2p-graph-frame {
    border-radius: 18px;
    background: #ffffff;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 91, 230, 0.06);
  }
  .graph-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background: #f8fafc;
    border-bottom: 1px solid var(--border);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
  }
  .graph-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #0d0d0d;
    font-weight: 700;
  }
  .status-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #005be6;
  }
  .graph-meta {
    color: var(--text-muted);
  }
  .graph-interactive-body {
    padding: 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    background: #ffffff;
  }
  .pipeline-step {
    width: 100%;
    max-width: 320px;
  }
  .step-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }
  .accent-primary { color: #005be6; }
  .accent-green { color: #3eaf3f; }
  .step-card {
    padding: 0.85rem 1.15rem;
    border-radius: 12px;
    background: #ffffff;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }
  .active-card {
    border-color: #005be6;
    background: #dfecff;
  }
  .checkpoint-card {
    border-color: #3eaf3f;
    background: #ecfdf5;
  }
  .card-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: #0d0d0d;
  }
  .card-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .pipeline-edge {
    width: 2px;
    height: 28px;
    background: #e2e8f0;
    position: relative;
    overflow: hidden;
  }
  .edge-packet {
    position: absolute;
    width: 100%;
    height: 12px;
    background: #005be6;
    border-radius: 2px;
    animation: flow-down 1.8s infinite ease-in-out;
  }
  .packet-2 {
    animation-delay: 0.9s;
  }
  @keyframes flow-down {
    0% { top: -12px; opacity: 0; }
    50% { opacity: 1; }
    100% { top: 28px; opacity: 0; }
  }
  .graph-footer-telemetry {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 1rem 1.25rem;
    background: #f8fafc;
    border-top: 1px solid var(--border);
    font-family: 'JetBrains Mono', monospace;
    text-align: center;
  }
  .tel-label {
    display: block;
    font-size: 0.68rem;
    color: var(--text-muted);
    margin-bottom: 0.2rem;
  }
  .tel-val {
    font-size: 0.8rem;
    font-weight: 700;
    color: #0d0d0d;
  }
  .text-primary { color: #005be6; }
  .text-green { color: #3eaf3f; }
</style>
