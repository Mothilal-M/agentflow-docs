---
// apps/landing/src/components/FinalCta.astro
import { Button, InstallPill } from '@10xgraph/ui';
---

<section class="final-cta-section">
  <div class="cta-ambient-glow"></div>
  <div class="final-cta-container">
    <div class="cta-mark-wrap">
      <img
        src="/logo/10xgraph-icon-badge.jpg"
        alt="10xGraph Icon Badge"
        width="80"
        height="80"
        class="cta-icon-badge"
      />
    </div>

    <h2 class="final-title">Start Building Deterministic Agent Graphs Today</h2>
    <p class="final-desc">
      Open-source, self-hosted, MIT licensed. No credit card required, zero proprietary vendor lock-in.
    </p>

    <div class="final-actions">
      <a href="https://docs.10xgraph.com/get-started/first-agent" style="text-decoration: none;">
        <Button size="lg" variant="primary" client:visible>
          Read The Quick Start Guide →
        </Button>
      </a>
      <a href="https://github.com/10xGraph" target="_blank" rel="noopener noreferrer" style="text-decoration: none;">
        <Button size="lg" variant="outline" client:visible>
          Star On GitHub ★
        </Button>
      </a>
    </div>

    <div class="final-install">
      <InstallPill command="pip install 10xgraph 10xgraph-api" prefix="$" client:visible />
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    padding: 8rem 1.5rem;
    background: #030610;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    text-align: center;
    overflow: hidden;
  }
  .cta-ambient-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(0, 91, 230, 0.2) 0%, transparent 70%);
    filter: blur(50px);
    pointer-events: none;
  }
  .final-cta-container {
    max-width: 820px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cta-mark-wrap {
    margin-bottom: 2rem;
  }
  .cta-icon-badge {
    border-radius: 20px;
    box-shadow: 0 15px 40px rgba(0, 91, 230, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.15);
  }
  .final-title {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: #ffffff;
    margin-bottom: 1.25rem;
  }
  .final-desc {
    font-size: 1.15rem;
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 620px;
  }
  .final-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .final-install {
    display: flex;
    justify-content: center;
  }
</style>
